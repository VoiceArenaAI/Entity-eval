# Copy to .env and fill in. Only the keys for the models you run are needed.
# Keep comments on their own lines: anything after "=" is read as the value.

# Models called through OpenRouter (marked ¹ in the README)
OPENROUTER_API_KEY=
# openai_gpt_live_transcribe and openai_gpt_realtime_whisper (Realtime API, not on OpenRouter)
OPENAI_API_KEY=
# elevenlabs_scribe_v3 uses KEY1, elevenlabs_scribe_v3_live uses KEY2 (the same key can go in both)
ELEVENLAB_API_KEY1=
ELEVENLAB_API_KEY2=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OMI_API_KEY=
FISH_API_KEY=
SPEECHMATICS_API_KEY=
GRADIUM_API_KEY=
MURF_API_KEY=
SMALLEST_API_KEY=
XAI_API_KEY=
SONIOX_API_KEY=
META_API_KEY=
CARTESIA_API_KEY=
INWORLD_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only when using temporary AWS credentials
AWS_REGION=us-east-1
# aws_transcribe and aws_transcribe_medical (batch) upload audio here and delete it after each job
AWS_S3_BUCKET=
RESON8_API_KEY=
RIME_API_KEY=
MODULATE_API_KEY=
ZOOM_API_KEY=
# hf_jobs/: a token with write access and Jobs enabled
HF_TOKEN=
